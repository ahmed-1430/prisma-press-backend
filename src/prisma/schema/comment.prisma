// use prisma-8

model Comment {
  id        String               @id @default(uuid())
  content   String
  author    User              @relation(fields: [authorId], references: [id])
  authorId  String
  post      Post              @relation(fields: [postId], references: [id])
  postId    String
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()
}
