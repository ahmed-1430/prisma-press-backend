// use prisma-8

model Post {
  id        String    @id @default(uuid())
  title     String
  content   String?
  thumbnail String?
  isFeatured Boolean   @default(false)
  status    Boolean   @default(true)
  views     Int       @default(0)
  author    User      @relation(fields: [authorId], references: [id])
  authorId  String
  tags      tags[]?
  createdAt DateTime  @default(now())
  updatedAt temporal.updatedAt()
}
