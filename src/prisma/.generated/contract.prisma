// use prisma-8

model Comment {
  id        String               @id @default(uuid())
  content   String
  author    User              @relation(fields: [authorId], references: [id])
  authorId  String
  post      Post              @relation(fields: [postId], references: [id])
  postId    String
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()
}


enum activeStatus {
  ACTIVE
  BLOCKED
}

enum role {
  USER
  AUTHOR
  ADMIN
}

enum tags {
  TECHNOLOGY
  LIFESTYLE
  TRAVEL
  FOOD
  FASHION
  BUSINESS
  ENTERTAINMENT
  SPORTS
  HEALTH
  POLITICS
}

model Post {
  id        String    @id @default(uuid())
  title     String
  content   String?
  thumbnail String?
  isFeatured Boolean   @default(false)
  status    Boolean   @default(true)
  views     Int       @default(0)
  author    User      @relation(fields: [authorId], references: [id])
  authorId  String
  tags      tags[]?
  createdAt DateTime  @default(now())
  updatedAt temporal.updatedAt()
}


model Profile {
  id        String    @id @default(uuid())
  userId    String    @unique
  avatarUrl String?
  bio       String?
  user      User   @relation(fields: [userId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt temporal.updatedAt()

  @@map("profiles")
}


model User {
  id        String    @id @default(uuid())
  name      VarChar(255)
  email     VarChar(255) @unique
  password  String    
  activeStatus activeStatus     @default(ACTIVE) 
  role      role      @default(USER)
  profile   Profile?
  createdAt DateTime  @default(now()) 
  updatedAt temporal.updatedAt()

  @@map("users")
}

